# ============================================================
# HYPER TECH — Environment Variables Template
# ============================================================
# Copy this file to `.env` for local development, and add the
# same keys in Vercel → Project → Settings → Environment
# Variables (Production + Preview) for deployment.
#
# ⚠️ NEVER commit the real `.env` file (it is already in
#    .gitignore). These are production secrets.
# ============================================================

# ---------- Database (Neon PostgreSQL — REQUIRED) ----------
# Create a free database at https://neon.tech
# Use the POOLED connection string (the `-pooler` host) for
# serverless platforms like Vercel, keeping `&pgbouncer=true`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=20&pool_timeout=30"

# ---------- Cloudinary (product images — REQUIRED) ----------
# Create a free account at https://cloudinary.com
# Dashboard → Account Details. The API SECRET is used ONLY
# server-side (signed uploads) — never exposed to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Initial admin (REQUIRED on first boot) ----------
# Provisioned automatically ONCE when the database is empty.
# Rotate afterwards from the admin panel / database.
ADMIN_INITIAL_USERNAME="admin@hypertech.com"
ADMIN_INITIAL_PASSWORD="CHANGE-ME-strong-password"

# ---------- Session signing (REQUIRED) ----------
# Generate: openssl rand -hex 32
SESSION_SECRET=""

# ---------- Public app URL (optional) ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
